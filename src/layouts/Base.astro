---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Figure art to fetch early, for pages that open on a plate: 'front', 'back'. */
  preload?: string[];
  /** Keep the page out of search results, as the 404 is. */
  noindex?: boolean;
}
import { lensIds } from '../data/lenses';
import Rest from '../components/Rest.astro';
const { title, description = 'An illustrated, sourced atlas of Jin Shin Jyutsu: the 26 Safety Energy Locks, the depths, flows and fingers.', noindex = false, preload = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`${base}/og.jpg`, Astro.site).href;

// A newcomer's reading order: doing first, understanding after. The header, the menu and each page's "Next" share it.
const path_ = [
  { href: '/atlas/', label: 'Atlas', title: 'The atlas', gist: 'The twenty-six locks on the body.', group: 'Practise' },
  { href: '/fingers/', label: 'Fingers', title: 'The fingers', gist: 'Each finger holds an attitude.', group: 'Practise' },
  { href: '/flows/', label: 'Flows', title: 'The flows', gist: 'Holds in sequence, hand by hand.', group: 'Practise' },
  { href: '/clock/', label: 'Clock', title: 'The organ clock', gist: 'Each organ’s two hours, and its hold.', group: 'Practise' },
  { href: '/depths/', label: 'Depths', title: 'The depths', gist: 'Five layers, skin to bone.', group: 'Understand' },
  { href: '/history/', label: 'History', title: 'The history', gist: 'Where the art comes from.', group: 'Understand' },
  { href: '/glossary/', label: 'Glossary', title: 'The glossary', gist: 'The words of the art.', group: 'Understand' },
  { href: '/sources/', label: 'Sources', title: 'The sources', gist: 'How to learn more.', group: 'Understand' },
];
const groups = ['Practise', 'Understand'];
const here = path_.findIndex((p) => p.href === path);
const next = here >= 0 ? path_[(here + 1) % path_.length] : null;
const isActive = (href: string) => path.startsWith(href) || (href === '/atlas/' && path.startsWith('/lock/'));
---
<!doctype html>
<html lang="en-GB" data-lens="jsj">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · 26 Locks` : '26 Locks · An atlas of Jin Shin Jyutsu'}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="26 Locks" />
    <meta property="og:title" content={title ?? '26 Locks · An atlas of Jin Shin Jyutsu'} />
    <meta property="og:description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The 26 Locks figure, front and back, with the locks marked." />
    <meta name="twitter:card" content="summary_large_image" />
    {preload.map((p) => <link rel="preload" as="image" type="image/webp" href={`${base}/figure/${p}-shade.webp`} />)}
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <meta name="theme-color" content="#f3ebdd" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <script is:inline define:vars={{ lensIds }}>
      try {
        const t = localStorage.getItem('jsa-theme');
        if (t === 'dark') {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0d0f1c');
        }
      } catch {}
      try {
        const q = new URLSearchParams(location.search).get('lens');
        const l = q || sessionStorage.getItem('jsa-lens');
        if (lensIds.includes(l)) document.documentElement.dataset.lens = l;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href={`${base}/`} aria-label="26 Locks — home">
          <span class="seal jp" aria-hidden="true">手</span>
          <span class="brand-name">26 Locks</span>
        </a>
        <nav class="nav" aria-label="Main">
          {path_.map((n) => (
            <a href={`${base}${n.href}`} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="menu-btn" type="button" popovertarget="site-menu" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
        <button class="theme" type="button" aria-label="Toggle light / dark" title="Toggle light / dark">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M12 7a5 5 0 0 0 0 10z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>
    <div id="site-menu" class="menu" popover>
      <button class="menu-x" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Close menu">×</button>
      <a class="menu-home" href={`${base}/`}>Start here</a>
      {groups.map((g) => (
        <nav aria-label={g}>
          <p class="menu-k">{g}</p>
          {path_.filter((p) => p.group === g).map((p) => (
            <a class="menu-a" href={`${base}${p.href}`} aria-current={isActive(p.href) ? 'page' : undefined}>
              <span class="menu-t">{p.label}</span><span class="menu-g">{p.gist}</span>
            </a>
          ))}
        </nav>
      ))}
    </div>
    <main id="main">
      <slot />
      {next && (
        <nav class="wrap next-page" aria-label="Next page">
          <a href={`${base}${next.href}`}>
            <span class="np-k">{here === path_.length - 1 ? 'Back to the start' : 'Next'}</span>
            <span class="np-t serif">{next.title}</span>
            <span class="np-g">{next.gist}</span>
            <span class="np-arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      )}
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p class="serif foot-quote">Twenty-six locations, five depths, one breath.</p>
        <nav class="foot-nav" aria-label="About this site">
          <a href={`${base}/about/`}>About</a>
        </nav>
        <p class="muted small">
          An independent study reference. Jin Shin Jyutsu® is a registered trademark of Jin Shin Jyutsu, Inc. (Scottsdale, AZ), which this site is
          not affiliated with. The associations here are traditional, not medical advice, and no substitute for a qualified clinician.
          In an emergency, call for medical help first.
        </p>
      </div>
    </footer>
    <Rest />
    <script>
      // Citation marks: hover opens on pointers that hover, tap toggles; one open at a time.
      const closeAll = (except?: Element) => document.querySelectorAll('.cites.open').forEach((c) => {
        if (c !== except) { c.classList.remove('open'); c.querySelector('.cite-mark')?.setAttribute('aria-expanded', 'false'); }
      });
      const openCite = (c: Element) => {
        const m = c.querySelector('.cite-mark')!, p = c.querySelector<HTMLElement>('.cite-pop')!;
        closeAll(c); c.classList.add('open'); m.setAttribute('aria-expanded', 'true');
        const r = m.getBoundingClientRect(), w = Math.min(300, innerWidth - 24);
        p.style.left = `${Math.max(12, Math.min(r.left - w / 2, innerWidth - w - 12))}px`;
        const below = r.bottom + 8, h = p.offsetHeight;
        p.style.top = `${below + h > innerHeight - 8 ? Math.max(8, r.top - h - 8) : below}px`;
      };
      document.addEventListener('click', (e) => {
        const m = (e.target as Element).closest?.('.cite-mark');
        if (m) { e.preventDefault(); const c = m.parentElement!; c.classList.contains('open') ? closeAll() : openCite(c); }
        else if (!(e.target as Element).closest?.('.cite-pop')) closeAll();
      });
      if (matchMedia('(hover: hover)').matches) {
        let t = 0;
        document.addEventListener('pointerover', (e) => {
          const c = (e.target as Element).closest?.('.cites');
          clearTimeout(t);
          if (c && !c.classList.contains('open')) openCite(c);
          else if (!c) t = window.setTimeout(() => closeAll(), 250);
        });
      }
      // Capture catches scrollers inside the page too, like the atlas panel; a long popover scrolls itself.
      addEventListener('scroll', (e) => { if (!(e.target as Element).closest?.('.cite-pop')) closeAll(); }, { passive: true, capture: true });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !document.querySelector('.cites.open')) return;
        e.stopPropagation(); // one press, one layer: whatever lies under the popover stays open
        const c = (e.target as Element).closest?.('.cites');
        closeAll();
        c?.querySelector<HTMLElement>('.cite-mark')?.focus();
      }, true);
    </script>
    <script>
      // A link to #something can land short when figures load late and push the page down; land again once all is in.
      // Pages that place their own hash target set data-own-hash on <html>.
      const target = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (target) {
        let moved = false;
        for (const ev of ['wheel', 'touchstart', 'keydown']) addEventListener(ev, () => { moved = true; }, { once: true, passive: true });
        const land = () => setTimeout(() => {
          if (!moved && !document.documentElement.dataset.ownHash) target.scrollIntoView({ block: 'start', behavior: 'instant' });
        });
        if (document.readyState === 'complete') land(); else addEventListener('load', land, { once: true });
      }
    </script>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0d0f1c' : '#f3ebdd');
        try { localStorage.setItem('jsa-theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    view-transition-name: site-header; /* stays put while the page beneath cross-fades */
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .seal {
    display: grid; place-items: center; width: 34px; height: 40px; border-radius: 5px;
    background: var(--seal); color: var(--paper); font-size: 23px; line-height: 1;
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--seal) 70%, var(--paper));
  }
  .brand-name { font: 500 1.35rem/1 var(--serif); letter-spacing: .01em; }
  .nav { display: flex; gap: 2px; margin-left: auto; }
  .nav a {
    font: 500 .84rem/1 var(--sans); text-decoration: none; color: var(--ink-2);
    padding: 9px 12px; border-radius: 99px; white-space: nowrap; transition: background .2s, color .2s;
  }
  .nav a:hover { background: var(--paper-2); color: var(--ink); }
  .nav a[aria-current='page'] { background: var(--ink); color: var(--paper); }
  .theme {
    flex: none; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--rule);
    background: var(--card); color: var(--ink-2); display: grid; place-items: center; cursor: pointer;
  }
  .theme:hover { color: var(--seal); }
  .menu-btn { display: none; flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%; background: none; color: var(--ink); place-items: center; cursor: pointer; }
  .menu-btn:hover { background: var(--paper-2); }
  .menu {
    position: fixed; inset: 8px 8px auto auto; width: min(340px, calc(100vw - 16px)); max-height: calc(100dvh - 16px); margin: 0; padding: 20px 14px 14px;
    overflow-y: auto; border: 1px solid var(--rule); border-radius: 20px; background: var(--card); color: var(--ink); box-shadow: var(--shadow);
  }
  .menu:popover-open { animation: menu-in .22s var(--ease); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
  .menu::backdrop { background: rgb(0 0 0 / .22); }
  .menu-x { position: absolute; top: 8px; right: 8px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: none; color: var(--ink-2); font: 300 1.7rem/1 var(--sans); cursor: pointer; }
  .menu-home { display: inline-block; padding: 8px 10px; font: 500 1.35rem/1.1 var(--serif); text-decoration: none; }
  .menu-k { margin: 14px 10px 4px; font: 600 .64rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--seal); }
  .menu-a { display: block; padding: 8px 10px; border-radius: 12px; text-decoration: none; }
  .menu-a:hover { background: var(--paper-2); }
  .menu-a[aria-current='page'] { background: var(--paper-2); }
  .menu-t { display: block; font: 500 1.02rem/1.25 var(--sans); }
  .menu-g { display: block; font-size: .84rem; line-height: 1.35; color: var(--ink-3); }

  .next-page { margin-top: 48px; }
  .next-page a {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'k arrow' 't arrow' 'g arrow'; align-items: center; gap: 2px 20px;
    max-width: 560px; margin-left: auto; padding: 20px 24px; border: 1px solid var(--rule); border-radius: 16px;
    background: var(--card); color: inherit; text-decoration: none; transition: border-color .2s, transform .2s;
  }
  .next-page a:hover { border-color: var(--seal); transform: translateY(-1px); }
  .np-k { grid-area: k; font: 600 .66rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--seal); }
  .np-t { grid-area: t; font-size: 1.6rem; line-height: 1.2; color: var(--ink); margin-top: 4px; }
  .np-g { grid-area: g; font-size: .9rem; color: var(--ink-3); }
  .np-arrow { grid-area: arrow; font-size: 1.4rem; color: var(--seal); transition: transform .2s; }
  .next-page a:hover .np-arrow { transform: translateX(4px); }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 96px; padding: 40px 0 56px; }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0 0 14px; font: 500 .9rem var(--sans); }
  .foot-nav a { color: var(--ink-2); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 1px; }
  .foot-nav a:hover { color: var(--ink); border-color: currentColor; }
  .foot-quote { font-size: 1.35rem; margin-bottom: .6em; }
  .small { font-size: .82rem; max-width: 80ch; }

  @media (max-width: 1240px) { .bar { gap: 16px; } }
  @media (max-width: 1040px) {
    .nav { display: none; }
    .menu-btn { display: grid; }
    .brand { margin-right: auto; }
    .bar { gap: 8px; height: 60px; }
  }
  @media (max-width: 340px) { .brand-text { display: none; } }
</style>
