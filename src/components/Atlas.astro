---
import { selText } from '../lib/search';
import Plate from './Plate.astro';
import SelDetail from './SelDetail.astro';
import Term from './Term.astro';
import type { Sel, DepthInfo } from '../data/types';

interface Props { sels: Sel[]; depths: DepthInfo[] }
const { sels, depths } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const searchIndex = sels.map((s) => ({ n: s.n, text: selText(s) }));
const relatedMap = Object.fromEntries(sels.map((s) => [s.n, s.related.map((r) => r.n)]));
---
<section class="atlas" data-atlas>
  <div class="stage" data-stage>
    <div class="toolbar">
      <div class="view-toggle" role="group" aria-label="Choose view">
        <span class="vt-k">View</span>
        <div class="vt-seg">
          <button type="button" data-view="front" class="is-on" aria-pressed="true">Front</button>
          <button type="button" data-view="back" aria-pressed="false">Back</button>
          <button type="button" data-view="feet" aria-pressed="false">Feet</button>
        </div>
      </div>
      <div class="depth-filter" role="group" aria-label="Filter by depth">
        <a class="df-k" href={`${base}/depths/`} title="What the colours mean">Depths</a>
        <button type="button" class="df df-all is-on" data-depth="all" aria-pressed="true">All</button>
        {depths.map((d) => (
          <button type="button" class:list={['df', `d${d.n}`]} data-depth={d.n} aria-pressed="false" aria-label={`${d.name}, ${d.layer}`} title={`${d.name}: ${d.sels[0]}–${d.sels.at(-1)} · ${d.organs.join(' & ')}`}>
            <span class="dot" /><span class="df-n">{d.n}</span><span class="df-l">{d.layer.replace('Surface skin', 'Skin')}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="df-say">
      <span data-say="all">Tap a depth to see its <Term plural short />.</span>
      {depths.map((d) => (
        <span class={`d${d.n}`} data-say={d.n} hidden>
          <a href={`${base}/depths/#depth-${d.n}`}><b>{d.name}</b></a> · {d.layer} · {d.organs.join(' & ')} · {d.sels.length > 1 ? <><Term plural short /> {d.sels[0]}–{d.sels.at(-1)}</> : <><Term short /> {d.sels[0]}</>}
        </span>
      ))}
    </p>

    <div class="plates" data-view="front">
      <div class="fig fig-front">
        <div class="fig-head">
          <span class="eyebrow fig-side">Front</span>
          <a class="energy" href={`${base}/glossary/#term-ascending-descending`} title="Down the front, on the out-breath">Descending energy <span aria-hidden="true">↓</span></a>
        </div>
        <Plate plate="front" sels={sels} currents sides label="" />
      </div>
      <div class="fig fig-back">
        <div class="fig-head">
          <span class="eyebrow fig-side">Back</span>
          <a class="energy" href={`${base}/glossary/#term-ascending-descending`} title="Up the back, on the in-breath">Ascending energy <span aria-hidden="true">↑</span></a>
        </div>
        <Plate plate="back" sels={sels} currents sides label="" />
      </div>
      <div class="feet">
        <div class="fig-head"><span class="eyebrow">Feet</span></div>
        <Plate plate="medial" sels={sels} label="Inner foot" />
        <Plate plate="lateral" sels={sels} label="Outer foot" />
        <Plate plate="sole" sels={sels} label="Sole" class="sole" />
      </div>
    </div>

    <div class="tip" data-tip hidden>
      <span class="tip-n" data-tip-n></span>
      <span class="tip-body"><strong data-tip-name></strong><span data-tip-where></span></span>
    </div>
    <!-- Narrow screens, before any choice: say what the numbers are, and offer the list below. -->
    <button type="button" class="peek hint" data-hint>
      <span class="hint-n" aria-hidden="true">26</span>
      <span class="tip-body"><strong>Tap a number</strong><span>Each is a place where energy gathers.</span></span>
      <span class="peek-go" aria-hidden="true">↓</span>
    </button>
    <!-- Narrow screens: the chosen lock's name floats over the figure; tapping it drops to the detail below. -->
    <button type="button" class="peek" data-peek hidden>
      <span class="tip-n" data-peek-n></span>
      <span class="tip-body"><strong data-peek-name></strong><span data-peek-where></span></span>
      <span class="peek-go" aria-hidden="true">↓</span>
    </button>
  </div>

  <p class="sr-only" role="status" data-status></p>
  <aside class="panel" data-panel>
    <div class="panel-index" data-index>
      <header class="panel-head">
        <p class="eyebrow">The twenty-six</p>
        <h1 class="panel-title"><span data-lens-only="jsj"><Term plural cap /></span></h1>
        <p class="lede" data-lens-only="jsj">
          Places where the body’s energy gathers, and can lock shut. Rest a hand on one and the current moves again. Each is mirrored, left and right.
          Pick one on the body, or search by what you notice.
        </p>
        <label class="search">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          <input type="search" placeholder="Try “breath”, “knee”, “fear”, 15…" data-search aria-label="Search" />
        </label>
      </header>
      <div class="index-list" data-list>
        {depths.map((d) => (
          <section class:list={['group', `d${d.n}`]} data-group={d.n}>
            <header class="group-head">
              <span class="group-n">{d.n}</span>
              <span>
                <span class="group-name">{d.name} · {d.layer}</span>
                <span class="group-sub">{d.organs.join(' & ')}</span>
              </span>
            </header>
            <ol class="rows">
              {d.sels.map((n) => {
                const s = sels.find((x) => x.n === n)!;
                return (
                  <li>
                    <a class="row" href={`${base}/lock/${n}/`} data-n={n}>
                      <span class="row-n">{n}</span>
                      <span class="row-text">
                        <span class="row-name">{s.name}</span>
                        <span class="row-where" data-where-jsj={s.where}>
                          {s.where}
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
        <div class="no-match" data-nomatch hidden>
          <p data-nm-say></p>
          <p class="nm-try" data-nm-all hidden><button type="button">Search every depth</button></p>
          <p class="nm-try" data-nm-words>{['breath', 'sleep', 'worry', 'neck', 'digestion', '15'].map((w) => <button type="button" data-try={w}>{w}</button>)}</p>
        </div>
      </div>
    </div>

    <div class="panel-detail" data-detail tabindex="-1" hidden>
      <div class="detail-nav">
        <button type="button" class="back" data-close>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          All <Term plural short />
        </button>
        <span class="step">
          <button type="button" data-step="-1" aria-label="Previous lock">‹</button>
          <button type="button" data-step="1" aria-label="Next lock">›</button>
        </span>
      </div>
      {sels.map((s) => (
        <article class="detail" data-detail-n={s.n} hidden>
          <SelDetail sel={s} depth={depths.find((d) => d.n === s.depth)!} sels={sels} compact />
        </article>
      ))}
    </div>
  </aside>
</section>

<script define:vars={{ searchIndex, relatedMap }} is:inline>
  window.__atlas = { searchIndex, relatedMap };
</script>

<script>
  type W = Window & { __atlas: { searchIndex: { n: number; text: string }[]; relatedMap: Record<number, number[]> } };
  const { searchIndex, relatedMap } = (window as unknown as W).__atlas;

  const root = document.querySelector<HTMLElement>('[data-atlas]')!;
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const plates = root.querySelector<HTMLElement>('.plates')!;
  const marks = [...root.querySelectorAll<SVGGElement>('.plates .mk')];
  const rows = [...root.querySelectorAll<HTMLAnchorElement>('a.row')];
  const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
  const index = root.querySelector<HTMLElement>('[data-index]')!;
  const detail = root.querySelector<HTMLElement>('[data-detail]')!;
  const details = [...root.querySelectorAll<HTMLElement>('[data-detail-n]')];
  const tip = root.querySelector<HTMLElement>('[data-tip]')!;
  const peek = root.querySelector<HTMLButtonElement>('[data-peek]')!;
  const hint = root.querySelector<HTMLButtonElement>('[data-hint]')!;
  const panel = root.querySelector<HTMLElement>('[data-panel]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const narrow = matchMedia('(max-width: 920px)');
  hint.addEventListener('click', () => panel.scrollIntoView({ behavior: 'smooth' }));
  const [hintNum, hintHead, hintSub] = [hint.querySelector('.hint-n')!, hint.querySelector('strong')!, hint.querySelector('.tip-body span')!];
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const noMatch = root.querySelector<HTMLElement>('[data-nomatch]')!;
  const [nmSay, nmAll, nmWords] = ['say', 'all', 'words'].map((k) => noMatch.querySelector<HTMLElement>(`[data-nm-${k}]`)!);
  const names = new Map(rows.map((r) => [+r.dataset.n!, {
    name: r.querySelector('.row-name')!.firstChild!.textContent!,
    where: r.querySelector<HTMLElement>('.row-where')!.dataset,
    depth: [...r.closest('[data-group]')!.classList].find((c) => /^d\d$/.test(c))!,
  }]));

  let active: number | null = null;
  let depthFilter: string = 'all';
  let matches: Set<number> | null = null;
  let pushed = false; // an open lock holds a history entry of its own, so Back returns to the list

  const lens = () => document.documentElement.dataset.lens ?? 'jsj';
  const inLens = (el: HTMLElement | SVGElement) => !el.dataset.lensOnly || el.dataset.lensOnly.split(' ').includes(lens());
  const marksFor = (n: number) => marks.filter((m) => +m.dataset.n! === n && inLens(m));
  const viewOf = (m: Element) => {
    const p = m.closest<HTMLElement>('[data-plate]')?.dataset.plate;
    return p === 'front' || p === 'back' ? p : 'feet';
  };
  // The locks the depth and search leave showing, in order.
  const shown = () => rows.filter((r) => !r.parentElement!.hidden).map((r) => +r.dataset.n!).sort((a, b) => a - b);
  const notTouch = (e: PointerEvent) => e.pointerType !== 'touch'; // a tap has the peek card; a finger scrolling the list should not fire hovers

  function paint() {
    const related = new Set(active ? relatedMap[active] ?? [] : []);
    const depthSet = depthFilter === 'all' ? null : new Set(
      rows.filter((r) => r.closest(`[data-group="${depthFilter}"]`)).map((r) => +r.dataset.n!),
    );
    for (const m of marks) {
      const n = +m.dataset.n!;
      m.classList.toggle('is-active', n === active);
      m.classList.toggle('is-related', related.has(n));
      const inDepth = !depthSet || depthSet.has(n);
      const inSearch = !matches || matches.has(n);
      m.classList.toggle('is-match', !!(matches || depthSet) && inDepth && inSearch);
    }
    stage.classList.toggle('dimmed', !!(active || matches || depthSet));
    for (const r of rows) {
      const n = +r.dataset.n!;
      r.classList.toggle('is-active', n === active);
      const show = (!depthSet || depthSet.has(n)) && (!matches || matches.has(n));
      r.parentElement!.hidden = !show;
    }
    let any = false;
    for (const g of groups) {
      const vis = [...g.querySelectorAll('li')].some((li) => !li.hidden);
      g.hidden = !vis;
      any ||= vis;
    }
    noMatch.hidden = any;
    const q = search.value.trim();
    const depthName = depthSet ? root.querySelector(`[data-say="${depthFilter}"] b`)!.textContent! : '';
    // A word found elsewhere is the depth's doing, not the word's: say so, and offer the way out.
    const elsewhere = !!(depthSet && matches?.size);
    nmSay.textContent = elsewhere ? `The ${depthName} doesn’t mention “${q}”.` : 'Nothing mentions that. Try a body area, a feeling, or a number:';
    nmAll.hidden = !elsewhere;
    nmWords.hidden = elsewhere;
    // Narrow screens put the results below the figure, so the card says what was found.
    const filtered = !!(matches || depthSet), found = filtered ? shown().length : 26;
    hintNum.textContent = String(found);
    hintHead.textContent = !filtered ? 'Tap a number' : found === 1 ? 'One lock matches' : found ? `${found} locks match` : 'Nothing matches';
    hintSub.textContent = filtered ? `${[q && `“${q}”`, depthName].filter(Boolean).join(' in the ')}. See the list below.` : 'Each is a place where energy gathers.';
    hint.hidden = !!active;
    status.textContent = active ? `Lock ${active}, ${names.get(active)!.name}` : filtered ? `${found} of 26 locks shown` : '';
  }

  // One view at a time on a phone: if nothing showing is on this side, turn to a side that has some.
  function ensureView() {
    const on = new Set(shown());
    const hits = marks.filter((m) => on.has(+m.dataset.n!) && inLens(m));
    if (on.size < 26 && hits.length && !hits.some((m) => viewOf(m) === plates.dataset.view)) setView(viewOf(hits[0]));
  }

  function open(n: number, { push = true, reveal = true, focus = true } = {}) {
    const was = active;
    active = n;
    for (const d of details) d.hidden = +d.dataset.detailN! !== n;
    index.hidden = true;
    detail.hidden = false;
    detail.scrollTop = 0;
    root.classList.add('has-detail');
    // make sure the lock is visible on narrow screens, staying on this side if it is here too
    const ms = marksFor(n), m = ms.find((x) => viewOf(x) === plates.dataset.view) ?? ms[0];
    if (m) setView(viewOf(m));
    if (push && was === null) {
      history.scrollRestoration = 'manual'; // Back closes the lock, and close() places the page
      history.pushState(null, '', `#lock-${n}`);
      pushed = true;
    } else if (push) history.replaceState(history.state, '', `#lock-${n}`);
    const info = names.get(n)!;
    peek.querySelector('[data-peek-n]')!.textContent = String(n);
    peek.querySelector('[data-peek-name]')!.textContent = info.name;
    peek.querySelector('[data-peek-where]')!.textContent = info.where.whereJsj ?? '';
    peek.className = `peek ${info.depth}`;
    peek.hidden = false;
    paint();
    // The list above is gone or replaced, so without this a phone lands somewhere inside the detail.
    if (reveal && narrow.matches) panel.scrollIntoView({ behavior: 'instant', block: 'start' });
    if (focus) detail.focus({ preventScroll: true });
  }

  function close({ restore = true, rewind = true } = {}) {
    if (active === null) return;
    const n = active;
    const reading = !narrow.matches || panel.getBoundingClientRect().top < innerHeight / 2;
    active = null;
    index.hidden = false;
    detail.hidden = true;
    root.classList.remove('has-detail');
    peek.hidden = true;
    if (pushed && rewind) history.back();
    else if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
    pushed = false;
    paint();
    // Back to the row it was opened from, not to wherever the detail had scrolled.
    const row = rows.find((r) => +r.dataset.n! === n)!;
    if (restore && reading && !row.parentElement!.hidden) {
      row.scrollIntoView({ behavior: 'instant', block: narrow.matches ? 'center' : 'nearest' });
      if (!narrow.matches) row.focus({ preventScroll: true }); // a ring has no use on a touch screen
    }
  }

  function setView(v: string) {
    plates.dataset.view = v;
    tip.hidden = true;
    for (const b of root.querySelectorAll<HTMLButtonElement>('button[data-view]')) {
      b.classList.toggle('is-on', b.dataset.view === v);
      b.setAttribute('aria-pressed', String(b.dataset.view === v));
    }
  }

  // hover tooltip + cross-highlight
  function hover(n: number | null, anchor?: Element) {
    for (const m of marks) m.classList.toggle('is-hover', n !== null && +m.dataset.n! === n);
    for (const r of rows) r.classList.toggle('is-hover', n !== null && +r.dataset.n! === n);
    if (n === null || !anchor) { tip.hidden = true; return; }
    const info = names.get(n)!;
    tip.querySelector('[data-tip-n]')!.textContent = String(n);
    tip.querySelector('[data-tip-name]')!.textContent = info.name;
    tip.querySelector('[data-tip-where]')!.textContent = info.where.whereJsj ?? '';
    tip.className = `tip ${info.depth}`;
    const a = anchor.getBoundingClientRect();
    const s = stage.getBoundingClientRect();
    tip.hidden = false;
    const tw = tip.offsetWidth;
    let x = a.left + a.width / 2 - s.left - tw / 2;
    x = Math.max(8, Math.min(x, s.width - tw - 8));
    tip.style.left = `${x}px`; tip.style.top = `${a.top - s.top - tip.offsetHeight - 6}px`;
  }

  for (const m of marks) {
    const n = +m.dataset.n!;
    const toggle = () => (active === n ? close({ restore: false }) : open(n, { reveal: false, focus: false }));
    m.addEventListener('pointerenter', (e) => { if (notTouch(e)) hover(n, m); });
    m.addEventListener('pointerleave', (e) => { if (notTouch(e)) hover(null); });
    m.addEventListener('click', toggle);
    m.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  }
  for (const r of rows) {
    const n = +r.dataset.n!;
    r.addEventListener('pointerenter', (e) => {
      if (!notTouch(e)) return;
      const m = marksFor(n).find((x) => x.getBoundingClientRect().width > 0);
      hover(n, m);
    });
    r.addEventListener('pointerleave', (e) => { if (notTouch(e)) hover(null); });
    r.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      open(n);
    });
  }
  root.addEventListener('click', (e) => {
    const t = (e.target as Element).closest<HTMLElement>('[data-goto]');
    if (t) { e.preventDefault(); open(+t.dataset.goto!); }
  });

  root.querySelector('[data-close]')!.addEventListener('click', () => close());
  // Next and previous walk what the filter left showing, so stepping never leaves it.
  const step = (dir: number) => {
    const a = active ?? 0, on = shown(), pool = on.length ? on : rows.map((r) => +r.dataset.n!).sort((x, y) => x - y);
    open((dir > 0 ? pool.find((n) => n > a) ?? pool[0] : pool.findLast((n) => n < a) ?? pool.at(-1))!, { focus: false });
  };
  for (const b of root.querySelectorAll<HTMLButtonElement>('[data-step]')) b.addEventListener('click', () => step(+b.dataset.step!));
  function setDepth(d: string) {
    depthFilter = d;
    for (const x of root.querySelectorAll<HTMLButtonElement>('.df')) {
      x.classList.toggle('is-on', x.dataset.depth === d);
      x.setAttribute('aria-pressed', String(x.dataset.depth === d));
    }
    for (const x of root.querySelectorAll<HTMLElement>('[data-say]')) x.hidden = x.dataset.say !== d;
    // A depth chip always shows its locks, so it closes any open lock.
    if (active) close({ restore: false }); else paint();
    ensureView();
  }
  for (const b of root.querySelectorAll<HTMLButtonElement>('.df')) {
    b.addEventListener('click', () => {
      const d = b.dataset.depth!;
      // All means every lock, so it clears a search too; a depth tapped again lets go of it.
      if (d === 'all' && matches) { search.value = ''; applySearch(); }
      setDepth(d === depthFilter ? 'all' : d);
    });
  }
  for (const b of root.querySelectorAll<HTMLButtonElement>('button[data-view]')) {
    b.addEventListener('click', () => setView(b.dataset.view!));
  }

  function applySearch() {
    const q = search.value.trim().toLowerCase();
    if (!q) matches = null;
    else if (/^\d{1,2}$/.test(q)) matches = new Set([+q]);
    else {
      const terms = q.split(/\s+/);
      matches = new Set(searchIndex.filter((s) => terms.every((t) => s.text.includes(t))).map((s) => s.n));
    }
    // A ?q= the page arrived with stops being true once the words change.
    const u = new URLSearchParams(location.search);
    if (u.has('q') && u.get('q') !== search.value.trim()) {
      u.delete('q');
      history.replaceState(history.state, '', location.pathname + (`${u}` ? `?${u}` : '') + location.hash);
    }
    paint();
    ensureView();
  }
  search.addEventListener('input', applySearch);
  // The empty state offers words that are known to find something.
  for (const b of root.querySelectorAll<HTMLButtonElement>('[data-try]')) b.addEventListener('click', () => {
    search.value = b.dataset.try!;
    setDepth('all');
    applySearch();
    search.focus();
  });
  nmAll.querySelector('button')!.addEventListener('click', () => setDepth('all'));
  search.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    // On a phone the list is the answer: the Search key puts the keyboard away so it can be read.
    const on = shown();
    if (matches && on.length && (on.length === 1 || !narrow.matches)) open(on[0]);
    else if (narrow.matches) search.blur();
  });

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return; // Alt+Left is the browser's Back
    if (document.querySelector('dialog[open], [popover]:popover-open, .cites.open')) return; // Escape and the arrows belong to what is on top
    const el = e.target as HTMLElement;
    if (el === search) {
      if (e.key === 'Escape') { search.value = ''; applySearch(); search.blur(); }
      return;
    }
    if (el.matches('input, textarea, select')) return;
    if (e.key === 'Escape' && active) close();
    if (e.key === '/') { e.preventDefault(); close({ restore: false }); search.focus(); }
    if (active && e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    if (active && e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
  });


  const fromHash = (reveal: boolean) => {
    const m = location.hash.match(/^#lock-(\d{1,2})$/);
    if (m && +m[1] >= 1 && +m[1] <= 26) open(+m[1], { push: false, reveal, focus: false });
    else close({ rewind: false }); // Back, from an open lock
  };
  peek.addEventListener('click', () => panel.scrollIntoView({ behavior: 'smooth' }));
  fromHash(false);
  addEventListener('hashchange', () => fromHash(true));
  addEventListener('pagehide', () => { history.scrollRestoration = 'auto'; }); // the rest of the site keeps the browser's own
  // A reload or Back can restore the words in the box without their results.
  addEventListener('pageshow', () => { if (search.value.trim() && !matches) applySearch(); });
  // A lock page's theme chips arrive as ?q=, already searched.
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0 && !location.hash) { search.value = q0; applySearch(); }
  // Inside the panel the same chips filter in place rather than reloading the page.
  detail.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a.theme');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    close({ restore: false });
    search.value = new URL(a.href).searchParams.get('q') ?? '';
    setDepth('all');
    applySearch();
    index.scrollTop = 0;
