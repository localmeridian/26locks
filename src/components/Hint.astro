---
// A one-line usage hint under a page's lede: what to tap, try or read first.
interface Props { label?: string }
const { label = 'Try' } = Astro.props;
---
<p class="hint"><span class="hint-k">{label}</span><slot /></p>

<style>
  .hint {
    display: flex; gap: 10px; align-items: baseline; margin: 14px 0 0; max-width: 44em;
    font-size: .9rem; line-height: 1.5; color: var(--ink-2);
  }
  .hint-k {
    flex: none; min-width: 4.8em; font: 600 .62rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--seal);
  }
</style>
