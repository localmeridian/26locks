---
// The front door. Most visitors stay a minute, so the page leads with pictures: the 26 on
// the body with the Main Central current running through them, then three small moving
// diagrams for the depths, the flows and the fingers. Every claim carries its keys.
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import HistoryText from '../components/HistoryText.astro';
import { sels, depths } from '../data';
import { fingers } from '../data/system';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const range = (n: number[]) => (n.length > 1 ? `${n[0]}–${n.at(-1)}` : `${n[0]}`);
const rings = depths.map((d, i) => ({ n: d.n, r: 104 - i * 19, label: range(d.sels), layer: d.layer }));
const hand = ['thumb', 'index', 'middle', 'ring', 'little'].map((k) => fingers.find((f) => f.key === k)!);
// Fingertip heights for the little five-finger drawing, thumb to little finger.
const tipY = [96, 40, 26, 38, 62];
const word = (a: string | null) => (a ?? '').split(/[,/]/)[0].trim().toLowerCase();
// A short path of holds for the flow diagram: an anchor, then four places along a current.
const holds: [number, number][] = [[64, 44], [150, 70], [170, 122], [132, 168], [158, 214]];
const holdPath = 'M150 70 C176 88 182 104 170 122 C156 144 124 146 132 168 C140 190 166 194 158 214';
---
<Base description="A short, sourced introduction to Jin Shin Jyutsu and an illustrated atlas of its 26 Safety Energy Locks." preload={['front', 'back']}>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">An unofficial Jin Shin atlas</p>
      <h1>Twenty-six places to rest your hands.</h1>
      <p class="lede">
        <HistoryText t="Jin Shin Jyutsu is a Japanese art of gentle touch. In its teaching, energy can stall at these places, and two resting hands help it move again [H2, C01, C02]." />
      </p>
      <div class="cta">
        <a class="btn primary" href={`${base}/atlas/`}>Explore the atlas <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="hero-fig">
      <a class="fig-link" href={`${base}/atlas/`} aria-label="Explore the atlas">
        <div class="pair" aria-hidden="true">
          <div><Plate plate="front" sels={sels} interactive={false} currents label="" /><span class="cap">Down the front</span></div>
          <div><Plate plate="back" sels={sels} interactive={false} currents label="" /><span class="cap">Up the back</span></div>
        </div>
        <div class="feet" aria-hidden="true">
          {(['medial', 'lateral', 'sole'] as const).map((p) => <Plate plate={p} sels={sels} interactive={false} label="" />)}
          <span class="cap">And five on the feet</span>
        </div>
      </a>
      <figcaption>
        <span class="key">{depths.map((d) => <span class:list={['k', `d${d.n}`]}><i></i>{d.layer.replace('Surface skin', 'Skin')}</span>)}</span>
        <HistoryText t="Each colour is a depth; the moving light is the Main Central current [C01, C02]." />
      </figcaption>
    </figure>
  </section>

  <section class="wrap glance">
    <div class="g">
      <a class="g-link" href={`${base}/depths/`} aria-label="The depths">
      <svg class="g-art" viewBox="0 0 240 240" aria-hidden="true">
        {rings.map((r, i) => (
          <g class:list={['ring', `d${r.n}`]} style={`--i:${i}`}>
            <circle cx="120" cy="120" r={r.r} />
            <text x="120" y={120 - r.r + 4}>{r.label}</text>
          </g>
        ))}
        <text class="core" x="120" y="124">bone</text>
        <text class="skin" x="120" y="236">skin</text>
      </svg></a>
      <span class="g-k">Five depths</span>
      <span class="g-t"><HistoryText t="Five layers, skin to bone. Each has its own organs, finger and attitude [C01, C02]." /></span>
      <a class="g-more" href={`${base}/depths/`}>The depths <span aria-hidden="true">→</span></a>
    </div>

    <div class="g">
      <a class="g-link" href={`${base}/flows/`} aria-label="The flows">
      <svg class="g-art flow" viewBox="0 0 240 240" aria-hidden="true">
        <path class="fl-bed" d={holdPath} />
        <path class="fl-pulse" d={holdPath} pathLength="100" />
        <path class="fl-tie" d={`M${holds[0].join(' ')} Q100 40 ${holds[1].join(' ')}`} />
        <g class="fl-anchor" transform={`translate(${holds[0].join(' ')})`}><circle r="11" /><text dy=".35em">R</text></g>
        {holds.slice(1).map((h, i) => (
          <g class="fl-hold" style={`--i:${i}`} transform={`translate(${h.join(' ')})`}><circle r="11" /><text dy=".35em">L</text></g>
        ))}
      </svg></a>
      <span class="g-k">Flows</span>
      <span class="g-t"><HistoryText t="Energy runs in currents. A flow traces one: usually a hand rests while the other moves, hold by hold [C02, C04]." /></span>
      <a class="g-more" href={`${base}/flows/`}>The flows <span aria-hidden="true">→</span></a>
    </div>

    <div class="g" id="fingers">
      <a class="g-link" href={`${base}/fingers/`} aria-label="The fingers">
      <svg class="g-art hand" viewBox="0 0 240 240" aria-hidden="true">
        {hand.map((f, i) => (
          <g class:list={['fing', `d${f.depth}`]} style={`--i:${i}`}>
            <rect x={28 + i * 40} y={tipY[i]} width="24" height={170 - tipY[i]} rx="12" />
            <circle cx={40 + i * 40} cy={tipY[i] + 14} r="5" />
            <text x={40 + i * 40} y="196">{word(f.attitude)}</text>
          </g>
        ))}
      </svg></a>
      <span class="g-k">Hold a finger</span>
      <span class="g-t"><HistoryText t="Each finger holds an attitude. To work with these, wrap one in the other hand and breathe easily for a few minutes [C01, C05]." /></span>
      <a class="g-more" href={`${base}/fingers/`}>The fingers <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="wrap begin" id="first-hold">
    <div class="how">
      <p class="eyebrow">How a hold works</p>
      <ol>
        <li><b>Be as you are.</b> <HistoryText t="Sit, stand or lie down, fully clothed [C16]." /></li>
        <li><b>Rest a hand.</b> <HistoryText t="On a finger or a lock, lightly. No need to press hard or rub [C16]." /></li>
        <li><b>Let the breath move.</b> <HistoryText t="Out, then back in, at its own pace [A44]." /></li>
        <li><b>Stay a while.</b> <HistoryText t="A few minutes to begin, or until you feel a steady pulse [C16]." /></li>
      </ol>
    </div>
  </section>

  <section class="wrap story">
    <p class="eyebrow">Where it comes from</p>
    <p class="story-t">
      <HistoryText t="Jiro Murai developed Jin Shin Jyutsu, or in Burmeister’s word rediscovered it, in early twentieth-century Japan; his student Mary Burmeister taught it in the United States from the 1960s [C16, H3, H8, H13]. The name, in the usual translation: *the art of the Creator through the person of knowing and compassion* [H2]." />
    </p>
    <a class="more" href={`${base}/history/`}>The full history <span aria-hidden="true">→</span></a>
    <p class="lens-tip words-tip">
      New to the words? <a href={`${base}/glossary/#start`}>Start with five</a>: lock, depth, flow, attitude, and quickie.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 72px);
    align-items: center; min-height: min(84svh, 800px); padding-block: 40px 24px;
  }
  .hero h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1.02; margin: 10px 0 22px; letter-spacing: -.01em; }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.22rem); line-height: 1.6; color: var(--ink-2); max-width: 34em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 22px; border-radius: 99px;
    border: 1px solid var(--rule); font: 500 .95rem/1 var(--sans); text-decoration: none; color: var(--ink);
    transition: background .2s, border-color .2s, transform .2s var(--ease);
  }
  .btn:hover { border-color: var(--ink-4); transform: translateY(-1px); }
  .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .hero-fig { margin: 0; }
  .fig-link { display: block; color: inherit; text-decoration: none; }
  .fig-link :global(svg) { pointer-events: none; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; height: min(60svh, 580px); }
  /* 5, 6, 7, 16 and 24 sit on the feet; without them the figure shows 21 of the 26. */
  .feet { display: grid; grid-template-columns: 1.5fr 1.5fr .7fr; grid-template-rows: minmax(0, 1fr) auto; align-items: end; gap: 4px 10px; height: min(15svh, 140px); max-width: 420px; margin: 14px auto 0; }
  .feet :global(.plate) { height: 100%; min-height: 0; }
  .feet :global(.plate svg) { display: block; width: 100%; height: 100%; }
  .feet .cap { grid-column: 1 / -1; justify-self: center; }
  .pair > div { display: flex; flex-direction: column; align-items: center; height: 100%; min-width: 0; }
  .pair :global(.plate) { width: 100%; flex: 1 1 0; min-height: 0; } /* shrink to fit, so the feet never run into the captions */
  .pair :global(.plate svg) { display: block; width: 100%; height: 100%; }
  .cap { font: 600 .62rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--seal); margin-top: 6px; }
  .hero-fig figcaption { margin: 16px auto 0; max-width: 30em; text-align: center; font-size: .82rem; line-height: 1.5; color: var(--ink-3); }
  .key { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; margin-bottom: 6px; }
  .k { display: inline-flex; align-items: center; gap: 6px; font: 500 .72rem/1 var(--sans); color: var(--ink-2); }
  .k i { width: 8px; height: 8px; border-radius: 50%; background: var(--d); }

  /* What a hold is, in four steps. */
  .begin { padding-block: 72px 40px; border-top: 1px solid var(--rule); }
  .how ol { list-style: none; counter-reset: s; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px 32px; }
  .how li { counter-increment: s; position: relative; padding-left: 38px; color: var(--ink-2); font-size: .95rem; line-height: 1.5; }
  .how li::before { content: counter(s); position: absolute; left: 0; top: -1px; width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid var(--seal); border-radius: 50%; font: 500 1rem/1 var(--serif); color: var(--seal); }
  .how b { display: block; font: 500 1.2rem/1.25 var(--serif); color: var(--ink); }

  /* At a glance: three small diagrams, one idea each. */
  .glance { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 5vw, 64px); padding-block: 72px; border-top: 1px solid var(--rule); }
  .g { display: flex; flex-direction: column; }
  .g-link { display: block; }
  .g-art { display: block; width: min(220px, 100%); height: auto; margin: 0 auto 18px; overflow: visible; }
  .g-k { font: 450 1.7rem/1.1 var(--serif); }
  .g-t { margin-top: 8px; font-size: .92rem; line-height: 1.55; color: var(--ink-2); }
  .g-more { margin-top: 12px; font: 500 .85rem/1 var(--sans); color: var(--seal); text-decoration: none; }
  .g-more:hover { text-decoration: underline; }

  .ring circle { fill: none; stroke: var(--d); stroke-width: 15; opacity: .22; transition: opacity .3s; animation: breathe 6s var(--ease) infinite; animation-delay: calc(var(--i) * .5s); }
  .g:hover .ring circle { opacity: .4; }
  .ring text { font: 600 9px var(--sans); fill: var(--d); text-anchor: middle; }
  .core, .skin { font: 600 8px var(--sans); letter-spacing: .16em; text-transform: uppercase; fill: var(--ink-3); text-anchor: middle; }
  @keyframes breathe { 50% { opacity: .38; } }

  .flow path { fill: none; stroke: var(--seal); stroke-linecap: round; }
  .fl-bed { stroke-width: 12; opacity: .1; }
  .fl-pulse { stroke-width: 5; opacity: .8; stroke-dasharray: 8 92; animation: travel 5s linear infinite; }
  .fl-tie { stroke: var(--ink-4) !important; stroke-width: 1; stroke-dasharray: 2 4; }
  .flow text { font: 700 10px var(--sans); fill: var(--paper); text-anchor: middle; }
  .fl-anchor circle { fill: var(--ink-2); }
  .fl-hold circle { fill: var(--seal); opacity: .25; animation: hold 5s linear infinite; animation-delay: calc(var(--i) * 1.25s - .3s); }
  .fl-hold text { opacity: .5; }
  @keyframes travel { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes hold { 0%, 30% { opacity: 1; } 40%, 100% { opacity: .25; } }

  .fing rect { fill: var(--body-fill); stroke: var(--rule); transition: fill .3s; }
  .fing circle { fill: var(--d); animation: beckon 3s var(--ease) infinite; animation-delay: calc(var(--i) * .6s); transform-box: fill-box; transform-origin: center; }
  .fing text { font: italic 500 12px var(--serif); fill: var(--d); text-anchor: middle; }
  .g:hover .fing rect { fill: color-mix(in oklab, var(--d) 12%, var(--body-fill)); }
  @keyframes beckon { 50% { transform: scale(1.4); opacity: .6; } }

  .story { padding-block: 40px 64px; max-width: 46rem; }
  .story-t { font: 400 clamp(1.3rem, 2.4vw, 1.7rem)/1.45 var(--serif); margin: 10px 0 14px; }
  .more { font: 500 .9rem/1 var(--sans); color: var(--seal); text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .lens-tip { margin: 48px 0 0; font-size: .85rem; color: var(--ink-3); }
  .words-tip + .lens-tip { margin-top: 8px; }
  .words-tip a { color: var(--seal); }

  @media (prefers-reduced-motion: reduce) {
    .ring circle, .fl-pulse, .fl-hold circle, .fing circle { animation: none; }
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 28px; }
    .pair { height: 54svh; }
    .feet { height: 18svh; max-width: 100%; grid-template-columns: 1.3fr 1.3fr 1fr; gap: 4px 6px; }
    .glance { grid-template-columns: 1fr; padding-block: 48px; gap: 56px; }
    .begin { padding-block: 48px 32px; }
    .how ol { grid-template-columns: 1fr 1fr; }
    .g-art { width: 200px; }
  }
  @media (max-width: 520px) { .cta { justify-content: center; } .how ol { grid-template-columns: 1fr; gap: 16px; } }
</style>
