# Cloudflare static-asset headers, copied to dist/ by `npm run build`.
# Hashed build files never change, so they are kept for a year. The figure art keeps
# its name between builds, so it is kept for a day. Kept out of search engines for now, like the
# rest of localmeridian.net; drop the X-Robots-Tag line to let them in.
/26locks/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/26locks/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/26locks/figure/*
  Cache-Control: public, max-age=86400
