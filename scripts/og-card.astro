---
// The link preview, public/og.jpg (1200×630). To redraw it: copy this file to src/pages/og-card.astro, build, serve
// with `npm run preview`, take a 1200×630 screenshot of /26locks/og-card/, save it as a JPEG, delete the copy.
import '../styles/global.css';
import Plate from '../components/Plate.astro';
import { sels } from '../data';
---
<html lang="en-GB" data-lens="jsj" data-theme="light">
  <head><meta charset="utf-8" /><title>26 Locks</title></head>
  <body>
    <main class="card">
      <div class="words">
        <p class="eyebrow">26 Locks</p>
        <h1>Twenty-six places to rest your hands.</h1>
        <p class="sub">An illustrated, sourced atlas<br />of Jin Shin Jyutsu.</p>
      </div>
      <div class="figs">
        <Plate plate="front" sels={sels} interactive={false} label="" />
        <Plate plate="back" sels={sels} interactive={false} label="" />
      </div>
    </main>
  </body>
</html>

<style>
  body { margin: 0; background: var(--paper); }
  :global(body::before), :global(body::after) { display: none !important; }
  .card { box-sizing: border-box; width: 1200px; height: 630px; padding: 0 44px 0 76px; display: grid; grid-template-columns: 500px 1fr; align-items: center; gap: 12px; overflow: hidden; }
  .eyebrow { margin: 0 0 18px; font-size: 17px; color: var(--seal); }
  h1 { margin: 0; font-size: 70px; line-height: 1.02; letter-spacing: -.01em; }
  .sub { margin: 24px 0 0; font-size: 23px; line-height: 1.35; color: var(--ink-2); }
  .figs { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .figs :global(figure) { margin: 0; }
  .figs :global(svg) { display: block; width: 100%; height: 590px; }
</style>
